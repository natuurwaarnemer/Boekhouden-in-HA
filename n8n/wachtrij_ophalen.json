{"updatedAt":"2026-06-06T13:34:19.247Z","createdAt":"2026-06-05T21:59:09.515Z","id":"kLlWvSnKIYPn5CUy","name":"Natuurwaarnemer ERP — Wachtrij ophalen","description":null,"active":true,"isArchived":false,"nodes":[{"id":"wh1","name":"Webhook: Wachtrij ophalen","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[200,300],"parameters":{"path":"wachtrij-ophalen","responseMode":"responseNode","options":{},"httpMethod":"POST"},"webhookId":"b73d17ef-f909-4882-9d67-6982e111c94d"},{"id":"db1","name":"MySQL: Concept facturen","type":"n8n-nodes-base.mySql","typeVersion":2.4,"position":[400,300],"credentials":{"mySql":{"id":"AdVYD86SBj0ZYuto","name":"MySQL — erp"}},"parameters":{"operation":"executeQuery","query":"(SELECT i.invoice_number, c.name AS customer_name, COALESCE(i.notes, '') AS project, i.subtotal, i.btw_total, i.total FROM invoices i LEFT JOIN customers c ON i.customer_id = c.id WHERE i.status = 'concept' ORDER BY i.date ASC LIMIT 10) UNION ALL SELECT '__geen__','','',0,0,0"}},{"id":"fn1","name":"Function: Slots opbouwen","type":"n8n-nodes-base.code","typeVersion":2,"position":[600,300],"parameters":{"jsCode":"const rows = $input.all().map(r => r.json).filter(r => r.invoice_number !== '__geen__');\nconst slots = {};\nfor (let i = 1; i <= 10; i++) {\n  const row = rows[i-1];\n  if (row) {\n    const excl = parseFloat(row.subtotal || 0).toFixed(2);\n    const btw  = parseFloat(row.btw_total || 0).toFixed(2);\n    const tot  = parseFloat(row.total || 0).toFixed(2);\n    const proj = (row.project || row.notes || '').substring(0, 30);\n    slots['slot' + i] = row.invoice_number + '|' + (row.customer_name || '') + '|' + proj + '|' + excl + '|' + btw + '|' + tot;\n  } else {\n    slots['slot' + i] = '';\n  }\n}\nreturn [{ json: slots }];","mode":"runOnceForAllItems"}},{"id":"ha1","name":"HTTP: HA Script wachtrij laden","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[800,300],"parameters":{"method":"POST","url":"http://192.168.2.17:8123/api/servic