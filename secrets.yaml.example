# Kopieer dit bestand naar secrets.yaml en vul je eigen waarden in
# Gebruik nooit echte credentials in secrets.yaml.example!

# WiFi
wifi_ssid: "jouw_wifi_naam"
wifi_password: "jouw_wifi_wachtwoord"

# n8n ERP webhooks (intern IP van je n8n server)
n8n_webhook_klant:             "http://192.168.x.x:5678/webhook/klant-opslaan"
n8n_webhook_ververs_klanten:   "http://192.168.x.x:5678/webhook/ververs-klanten"
n8n_webhook_ververs_leveranciers: "http://192.168.x.x:5678/webhook/ververs-leveranciers"
n8n_webhook_leverancier:           "http://192.168.x.x:5678/webhook/leverancier-opslaan"
n8n_webhook_leverancier_laden:     "http://192.168.x.x:5678/webhook/leverancier-laden"
n8n_webhook_leverancier_bijwerken: "http://192.168.x.x:5678/webhook/leverancier-bijwerken"
n8n_webhook_leverancier_verwijderen: "http://192.168.x.x:5678/webhook/leverancier-verwijderen"
n8n_webhook_klant_laden:      "http://192.168.x.x:5678/webhook/klant-laden"
n8n_webhook_klant_bijwerken:  "http://192.168.x.x:5678/webhook/klant-bijwerken"
n8n_webhook_klant_verwijderen: "http://192.168.x.x:5678/webhook/klant-verwijderen"
n8n_webhook_factuur:          "http://192.168.x.x:5678/webhook/factuur-aanmaken"
n8n_webhook_inkoop:           "http://192.168.x.x:5678/webhook/inkoop-opslaan"
n8n_webhook_wachtrij_ophalen:  "http://192.168.x.x:5678/webhook/wachtrij-ophalen"
n8n_webhook_wachtrij_versturen: "http://192.168.x.x:5678/webhook/wachtrij-versturen"
n8n_webhook_facturen_per_klant:   "http://192.168.x.x:5678/webhook/facturen-per-klant"
n8n_webhook_factuur_detail:       "http://192.168.x.x:5678/webhook/factuur-detail"
n8n_webhook_factuur_bijwerken:    "http://192.168.x.x:5678/webhook/factuur-bijwerken"
n8n_webhook_factuur_verwijderen:  "http://192.168.x.x:5678/webhook/factuur-verwijderen"
n8n_webhook_inkopen_per_lev:      "http://192.168.x.x:5678/webhook/inkopen-per-leverancier"
n8n_webhook_inkoop_detail:        "http://192.168.x.x:5678/webhook/inkoop-detail"
n8n_webhook_inkoop_bijwerken:     "http://192.168.x.x:5678/webhook/inkoop-bijwerken"
n8n_webhook_inkoop_verwijderen:   "http://192.168.x.x:5678/webhook/inkoop-verwijderen"

# HA long-lived access token (voor n8n → HA callbacks)
n8n_ha_token: "jouw_ha_long_lived_token"
